rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── ASHA Workers ──────────────────────────────────────────────
    match /asha_workers/{workerId} {
      allow read: if isOwner(workerId);
      allow create: if isAuthenticated() && request.auth.uid == workerId;
      allow update: if isOwner(workerId);
      allow delete: if false; // Workers cannot delete their own profile
    }

    // ── Children ──────────────────────────────────────────────────
    match /children/{childId} {
      allow read: if isAuthenticated() &&
        resource.data.createdByASHA == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.createdByASHA == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.createdByASHA == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.createdByASHA == request.auth.uid;
    }

    // ── Screenings ────────────────────────────────────────────────
    match /screenings/{screeningId} {
      allow read: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.ashaId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow delete: if false;
    }

    // ── BOA Results ───────────────────────────────────────────────
    match /boa_results/{resultId} {
      allow read: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.ashaId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow delete: if false;
    }

    // ── Referrals ─────────────────────────────────────────────────
    match /referrals/{referralId} {
      allow read: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.ashaId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow delete: if false;
    }

    // ── Follow-ups ────────────────────────────────────────────────
    match /followups/{followupId} {
      allow read: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.ashaId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.ashaId == request.auth.uid;
      allow delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // ── Reports ───────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAuthenticated() &&
        resource.data.generatedBy == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.generatedBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── Legacy collections (users, babies, etc.) ──────────────────
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /babies/{babyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /questionnaire_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /boa_sessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }

    match /boa_trials/{trialId} {
      allow read, write: if isAuthenticated();
    }
  }
}
