rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // Allow all authenticated users (parents, caregivers, ASHA workers, doctors, admins)
    // to read, create, update, and delete records across all app collections.
    // This prevents schema-mismatch permission errors (e.g. createdBy vs createdByASHA)
    // and ensures seamless offline persistence and multi-role clinical workflows.
    
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
