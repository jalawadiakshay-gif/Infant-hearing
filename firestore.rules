rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function auth() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }
    function isAdmin() { return auth() && userRole() == 'admin'; }
    function isClinician() { return auth() && userRole() == 'clinician'; }

    // ── users: own profile only (admin can read all) ────────
    match /users/{userId} {
      allow read: if auth() && (uid() == userId || isAdmin());
      allow create: if auth() && uid() == userId;
      allow update: if auth() && uid() == userId;
      allow delete: if false;
    }

    // ── children: creator, admin, clinician ──────────────────
    match /children/{childId} {
      allow read: if auth() && (
        resource.data.createdBy == uid() ||
        isAdmin() ||
        isClinician()
      );
      allow create: if auth() &&
        request.resource.data.createdBy == uid();
      allow update: if auth() && (
        resource.data.createdBy == uid() || isAdmin()
      );
      allow delete: if false;
    }

    // ── screenings: conductor, admin, clinician ─────────────
    match /screenings/{screeningId} {
      allow read: if auth() && (
        resource.data.conductedBy == uid() ||
        isAdmin() ||
        isClinician()
      );
      allow create: if auth() &&
        request.resource.data.conductedBy == uid();
      allow update: if auth() && (
        resource.data.conductedBy == uid() || isAdmin()
      );
      allow delete: if false;
    }

    // ── referrals: referring ASHA, admin, clinician ──────────
    match /referrals/{referralId} {
      allow read: if auth() && (
        resource.data.ashaId == uid() ||
        isAdmin() ||
        isClinician()
      );
      allow create: if auth() &&
        request.resource.data.ashaId == uid();
      allow update: if auth() && (
        resource.data.ashaId == uid() ||
        isAdmin() ||
        isClinician()
      );
      allow delete: if false;
    }

    // ── followups: assigned ASHA, admin ─────────────────────
    match /followups/{followupId} {
      allow read: if auth() && (
        resource.data.ashaId == uid() || isAdmin()
      );
      allow create: if auth() &&
        request.resource.data.ashaId == uid();
      allow update: if auth() && (
        resource.data.ashaId == uid() || isAdmin()
      );
      allow delete: if isAdmin();
    }
  }
}
